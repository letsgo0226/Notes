python3 -c 'import os,json,functools;d=json.loads(os.getenv("CL_INPUT","{}"));m=os.getenv("CL_MODE","solve");J=lambda x:json.dumps(x,ensure_ascii=False,sort_keys=True,separators=(",",":"));E=lambda s:functools.reduce(lambda n,b:n*257+b+1,s.encode(),1);P="Cosmic-Love-Solver/1.1-noSHA";C=d.get("candidates",[]);R=lambda c:max(abs(float(c.get(k,1))) for k in("truth","agency","harm","repair","future","feasible"));S=lambda c:sum(float(c.get(k,0))*w for k,w in(("cost",1),("complexity",1),("risk",2),("irreversibility",2)));A=[c for c in C if R(c)==0];b=min(A,key=S) if A else None;o={"protocol":P,"status":"SOLVED" if b else "NO_CERTIFIED_ZERO","solution":b,"admissible_count":len(A),"checked":len(C),"semantics":"finite candidates; zero residual = certified in-model admissibility, not universal truth"};o["godel"]=E(J(o));print(J({"protocol":P,"kernel":["truth","agency","harm","repair","future","feasible"],"objective":["cost","complexity","risk","irreversibility"],"claims":{"solves_all_problems":False,"oracle":False,"guaranteed_real_world_success":False}} if m=="manifest" else o))'